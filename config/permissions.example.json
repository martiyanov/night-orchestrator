{
  "$comment": "Example execution policy. Copy to config/permissions.json and adjust budgets. DEPLOY_ENABLED must stay false for unattended work.",
  "DEPLOY_ENABLED": false,
  "production_checkout_writes": false,
  "push_main": false,
  "push_feature_branch": false,
  "merge_to_main": false,
  "worktree_commits": true,
  "max_executor_attempts": 2,
  "max_post_strong_review_attempts": 1,
  "command_timeout_seconds": 300,
  "on_permission_violation": "STOP_RUN",
  "execution_profile": "balanced",
  "profiles": {
    "balanced": {
      "$comment": "DEFAULT. Flash starts; GLM-5.3 takeover on stalled exploration; no return to Flash after takeover; retry/takeover receives compact handoff, never the accumulated transcript. || AG-107-07 postmortem: 60 мин не хватило на оформление RESULT при готовой реализации (коммит создан, тесты зелёные) — 75 мин; остальные бюджеты не менялись.",
      "executor_model": "zai/glm-5.3-flash",
      "takeover_model": "zai/glm-5.3",
      "max_agent_turns": 24,
      "first_write_target_minutes": 10,
      "task_hard_budget_minutes": 75,
      "escalate_after_turns_without_write": 6,
      "escalate_after_minutes_without_write": 10,
      "escalate_after_reads_post_write": 3,
      "max_invalid_nudges": 2,
      "history_compact_bytes": 40960,
      "max_read_calls_before_write": 6,
      "max_exploration_minutes": 15,
      "max_repeat_reads": 3,
      "max_compactions_before_escalation": 2,
      "max_read_calls_implementer": 5,
      "post_write_extra_turns": 8
    },
    "fast": {
      "$comment": "FAST (AG-107-02 postmortem, PHASE-3 spec): дешёвое исследование на Flash; ранний exploration deadline (reads<=10 / 12min / compactions<=2); нет progress -> takeover на GLM-5.3 (=balanced strength); hard 45min. Легаси-вариант 'glm-5.3 сразу' не эскалировался (same-model) и выгорал в чтении.",
      "executor_model": "zai/glm-5.3-flash",
      "takeover_model": "zai/glm-5.3",
      "max_agent_turns": 24,
      "first_write_target_minutes": 10,
      "task_hard_budget_minutes": 45,
      "escalate_after_turns_without_write": 6,
      "escalate_after_minutes_without_write": 10,
      "escalate_after_reads_post_write": 3,
      "max_invalid_nudges": 2,
      "history_compact_bytes": 40960,
      "max_read_calls_before_write": 5,
      "max_exploration_minutes": 12,
      "max_repeat_reads": 3,
      "max_compactions_before_escalation": 2,
      "max_read_calls_implementer": 4,
      "post_write_extra_turns": 8
    },
    "economy": {
      "$comment": "Cheap models with wider time budgets; takeover stays cheap.",
      "executor_model": "zai/glm-5.3-flash",
      "takeover_model": "zai/glm-5.3-flash",
      "max_agent_turns": 32,
      "first_write_target_minutes": 20,
      "task_hard_budget_minutes": 120,
      "escalate_after_turns_without_write": 10,
      "escalate_after_minutes_without_write": 20,
      "escalate_after_reads_post_write": 5,
      "max_invalid_nudges": 3,
      "history_compact_bytes": 40960,
      "max_read_calls_before_write": 8,
      "max_exploration_minutes": 20,
      "max_repeat_reads": 4,
      "max_compactions_before_escalation": 2,
      "max_read_calls_implementer": 6,
      "post_write_extra_turns": 8
    }
  }
}