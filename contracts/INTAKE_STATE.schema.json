{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Night Orchestrator Intake State",
  "type": "object",
  "required": ["intake_id", "project", "original_message", "classification", "known_facts", "open_questions", "owner_answers", "status", "created_at", "updated_at"],
  "properties": {
    "intake_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}-[a-z0-9-]{1,40}$" },
    "project": { "type": "string" },
    "original_message": { "type": "string" },
    "classification": { "enum": ["DISCUSSION", "BACKLOG", "RUN", "NEEDS_CLARIFICATION"] },
    "known_facts": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["qid", "text"],
        "properties": {
          "qid": { "type": "string" },
          "text": { "type": "string" },
          "asked": { "type": "boolean" },
          "answer": { "type": "string" }
        }
      }
    },
    "owner_answers": { "type": "object" },
    "proposed_task": { "type": ["object", "null"] },
    "backlog_draft": { "type": ["string", "null"] },
    "status": { "enum": ["NEW", "NEEDS_CLARIFICATION", "READY_TO_RUN", "READY_TO_BACKLOG", "WAITING_OWNER", "CANCELLED", "DEFERRED", "COMPLETED"] },
    "chat": {
      "type": ["object", "null"],
      "properties": {
        "chat_id": { "type": ["string", "integer"] },
        "message_id": { "type": "integer" },
        "reply_to_message_id": { "type": "integer" }
      }
    },
    "source_run": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
